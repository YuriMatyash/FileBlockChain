# PrintChain backend local demo settings. Placeholders only; do not commit secrets.
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional future IPFS provider placeholders. Do not expose these directly in frontend code.
IPFS_PROVIDER_API_URL=
IPFS_PROVIDER_API_KEY=
IPFS_PROVIDER_API_SECRET=

# Phase 8 x402-style demo is mocked by default.
# Accepted mock proof: header "x-printchain-demo-payment: paid" or query "?demoPaid=true".
# No real payment provider credentials are required.

# Marketplace access-gate demo: default receiver is Hardhat account #0/deployer.
# The backend verifies the submitted transaction against this local RPC, then remembers
# unlocked wallets only until it restarts. Do not use a real wallet or production RPC.
HARDHAT_RPC_URL=http://127.0.0.1:8545
MARKETPLACE_ACCESS_RECEIVER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
